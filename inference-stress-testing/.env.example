# Copy to .env. Do not commit .env or paste credentials into chat.
AI_ENDPOINT=http://host.docker.internal:8000
AI_MODEL=your-served-model-name
AI_API_KEY=
# Hugging Face tokenizer ID or mounted local path matching the served model.
TOKENIZER=your-org/your-model
HF_TOKEN=
GUIDELLM_IMAGE=ghcr.io/vllm-project/guidellm:v0.8.0
EVAL_IMAGE=python:3.12-slim
RUNNER_CPUS=2
RUNNER_MEMORY=4g
# On Linux set these to the output of id -u and id -g if different.
LOCAL_UID=1000
LOCAL_GID=1000
STREAMS=12,24
PROMPT_TOKENS=5000,20000,50000,50000,100000
OUTPUT_TOKENS=256,2048,512,2048,2048
MIX_WEIGHTS=15,15,30,35,5
REQUESTS_PER_STAGE=200
DURATION_SECONDS=300
WARMUP_SECONDS=15
REQUEST_TIMEOUT_SECONDS=120
SEED=42
# Set to the actual context limit. Prompt + output + margin must fit.
CONTEXT_TOKENS=131072
CONTEXT_MARGIN=256
QUALITY_EVAL=1
EVAL_MAX_ERROR_RATE=0
EVAL_MIN_COMPLETED_REQUESTS=100
EVAL_P95_TTFT_MS=
EVAL_P95_ITL_MS=
EVAL_P95_E2E_MS=
EVAL_MIN_OUTPUT_TPS=
# Optional: existing Ray Serve cluster; no Ray mutation happens during runner run.
RAY_DASHBOARD_URL=
RAY_AUTH_TOKEN=
RAY_SERVE_CONFIG=/work/serve.json
RAY_APP_NAME=
RAY_DEPLOYMENT_NAME=
RAY_NUM_REPLICAS=
RAY_MAX_ONGOING_REQUESTS=
RAY_NUM_CPUS=
RAY_NUM_GPUS=
RAY_READY_TIMEOUT_SECONDS=900
